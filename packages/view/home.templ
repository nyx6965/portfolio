package view

templ Home() {
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Always laugh at the competition."/>
			<title>mertens</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			<main>
				<h2 class="headers" class="name">mertens</h2>
				<nav class="nav">
					<a class="normal_text" href="/">home</a>
					<a class="normal_text" href="/blogs">posts</a>
					<hr/>
				</nav>
				<p>learning ml, cs &amp; low-level</p>
